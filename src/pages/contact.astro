---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---

<Layout title={`Contact | ${site.name}`} description={`Send a note, share a prayer request, or say hello to ${site.name}.`}>
  <section class="bg-mauve-light">
    <div class="mx-auto max-w-3xl px-4 py-14">
      <div data-copy="C1">
      <h1 class="text-4xl font-semibold sm:text-5xl">Get in Touch</h1>
      <p class="mt-3 text-lg text-ink/75">
        Whether you have a prayer request, a question, or just want to say hello — I'd love to hear
        from you.
      </p>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <ContactForm />
  </section>
</Layout>
