---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
import { getPosts } from "../../lib/sanity";

const posts = await getPosts();
---

<Layout title={`Blog | ${site.name}`} description={`All posts from ${site.name}. ${site.description}`}>
  <section class="bg-mauve-light">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <h1 class="text-4xl font-semibold sm:text-5xl">The Blog</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink/75">Reflections on faith, story, and living present with God each day.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pt-12">
    {
      posts.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="text-center text-ink/70">The first posts are on their way — check back soon.</p>
      )
    }
  </section>
</Layout>
