---
import { site, navLinks } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t-4 border-sunshine bg-ink text-white/80">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-12 sm:grid-cols-2">
    <div>
      <p class="font-display text-xl font-semibold text-white">{site.name}</p>
      <p class="mt-2 max-w-sm">{site.tagline}</p>
    </div>
    <nav class="flex flex-wrap content-start gap-x-6 gap-y-2 sm:justify-end" aria-label="Footer">
      {navLinks.map((link) => <a href={link.href} class="hover:text-sunshine">{link.label}</a>)}
      <a href="/rss.xml" class="hover:text-sunshine">RSS</a>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-5xl px-4 py-4 text-sm text-white/50">
      &copy; {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
